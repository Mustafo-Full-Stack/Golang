# ============================================================================
# ФАЙЛ: Makefile
# НАЗНАЧЕНИЕ: Короткие кнопки-команды (`make db`, `make run`, `make up`) вместо длинных команд в терминале.
# ============================================================================
#
# 🧒 ОБЪЯСНЕНИЕ ДЛЯ 10-ЛЕТНЕГО РЕБЁНКА:
#   Чтобы каждый раз не печатать в терминале длинные заклинания вроде
#   `docker compose up -d --wait db`, программисты записывают их в файл `Makefile`
#   и дают им короткие имена! Написал два слова `make db` — и база данных сама запустилась!
#
# 🍕 ПРИМЕРЫ НА РЕСТОРАНЕ (2 НАГЛЯДНЫХ ПРИМЕРА):
#   ПРИМЕР 1: Пульт управления рестораном с большими кнопками
#     - Кнопка `make db`    — "Открыть только продуктовый склад (PostgreSQL)";
#     - Кнопка `make run`   — "Запустить наш сервер Go прямо из редактора";
#     - Кнопка `make up`    — "Запустить весь ресторан целиком в Docker";
#     - Кнопка `make down`  — "Закрыть смену на ночь (все продукты сохраняются)";
#     - Кнопка `make reset` — "Полная генеральная уборка со сбросом склада с нуля".
#
#   ПРИМЕР 2: Автоматическая подгрузка настроек (`-include .env` и `export`)
#     Первые две строчки файла (`-include .env` и `export`) работают как ассистент:
#     перед нажатием любой кнопки пульта они сами читают твой файл `.env` и передают
#     все пароли и секреты внутрь Go-программы!
# ============================================================================

# Если файл `.env` существует — прочитать его (знак `-` спереди означает "не ругайся, если файла `.env` ещё нет").
-include .env
# Передать все прочитанные переменные из `.env` в запускаемые команды (`go run`, `docker compose`).
export

# Список команд-кнопок (чтобы `make` знал, что это названия действий, а не имена файлов).
.PHONY: run db up down reset logs fmt vet test

# Запустить API локально (база должна работать: make db).
run:
	go run ./cmd/api

# Поднять только PostgreSQL и дождаться готовности.
db:
	docker compose up -d --wait db

# Поднять базу и приложение в Docker.
up:
	docker compose up --build -d

# Остановить контейнеры, данные базы сохраняются.
down:
	docker compose down

# Удалить контейнеры и данные базы.
reset:
	docker compose down -v

# Посмотреть живые логи работающего контейнера приложения.
logs:
	docker compose logs -f app

# Автоматически красиво выровнять отступы во всех `.go` файлах проекта.
fmt:
	gofmt -w $$(find . -name '*.go' -not -path './.git/*')

# Проверить код анализатором Go на скрытые ошибки.
vet:
	go vet ./...

# Проверка перед коммитом: форматирование, vet и тесты.
test:
	test -z "$$(gofmt -l .)"
	go vet ./...
	go test ./...