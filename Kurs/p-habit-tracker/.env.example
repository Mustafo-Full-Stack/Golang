# ============================================================================
# ФАЙЛ: .env.example (Шаблон переменных окружения)
# НАЗНАЧЕНИЕ: Показывает, какие настройки нужны серверу для запуска.
# Как использовать: скопируй этот файл в `.env` (команда `cp .env.example .env`).
# ============================================================================
#
# 🧒 ОБЪЯСНЕНИЕ ДЛЯ 10-ЛЕТНЕГО РЕБЁНКА:
#   Настоящие пароли никогда не хранят внутри кода, чтобы случайно не выложить их в интернет.
#   Поэтому в проект кладут учебный черновик `.env.example` ("пример настроек"),
#   а у себя на компьютере ты делаешь из него копию `.env` со своими секретами!
#
# 🍕 ПРИМЕРЫ НА РЕСТОРАНЕ (2 НАГЛЯДНЫХ ПРИМЕРА):
#   ПРИМЕР 1: Бланк настроек нового филиала ресторана
#     Директор даёт управляющему пустой образец `.env.example`, где написано:
#     "Тут укажи номер окошка выдачи (`HTTP_PORT`), а тут — секретный код сейфа (`JWT_SECRET`)".
#   ПРИМЕР 2: Адрес продуктового склада (`POSTGRES_...`)
#     Нижние 6 строчек — это пропуск для экспедитора на склад PostgreSQL:
#     на каком компьютере склад (`POSTGRES_HOST`), какая дверь (`POSTGRES_PORT`), логин и пароль.
# ============================================================================

# На каком порту запускается наш HTTP-сервер (по умолчанию 8080 -> http://localhost:8080)
HTTP_PORT=8080

# Секретный ключ для подписи JWT-токенов (ОБЯЗАТЕЛЬНЫЙ параметр!)
JWT_SECRET=change-me-to-a-long-random-string

# Сколько времени живёт выданный JWT-токен (24h = 24 часа)
JWT_TTL=24h

# Настройки подключения к базе данных PostgreSQL:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=habits
POSTGRES_SSLMODE=disable
