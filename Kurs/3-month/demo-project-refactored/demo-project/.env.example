APP_ENV=local
LOG_LEVEL=debug
LOG_FILE=app.log

HTTP_PORT=8080
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=10s

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=demo-db
POSTGRES_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Только для локальной разработки. На сервере — свой случайный: openssl rand -hex 32
JWT_SECRET=local-dev-secret-change-me-in-production
JWT_ISSUER=demo-project
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=demo-media
S3_USE_SSL=false
S3_PRESIGN_TTL=15m
S3_MAX_UPLOAD_BYTES=10485760

# Фоновая очистка раз в CLEANUP_INTERVAL: брошенные загрузки и истёкшие сессии.
# CLEANUP_UNATTACHED_TTL — сколько живёт файл, который так и не прикрепили к посту.
CLEANUP_ENABLED=true
CLEANUP_INTERVAL=30m
CLEANUP_UNATTACHED_TTL=24h
